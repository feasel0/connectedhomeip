examples/thermostat/ameba/build

# Downloaded zap without a pigweed root (via zap_download.py)
.zap

# When building esp-idf application, if any component is fetched using idf-component-manager then they are stored in
# managed_component directory. Along with that dependencies.lock file is generated.
# https://github.com/espressif/idf-component-manager#using-with-a-project
examples/*/esp32/managed_components
examples/*/esp32/dependencies.lock

# jupyter temporary files
.ipynb_checkpoints

# Initial layout generated by imgui
imgui.ini

# Joint Fabric test harness output file
admin_storage.json

# Local issue #37075 generated and machine-local artifacts. Documentation,
# configuration, and build-proof summaries under /37075 remain trackable.
/37075/37075_Issue_reference_logs/
/37075/TC_Darwin_Pair_logs/
/37075/ble_thread_iter_7_fail/
/37075/logs/

# Per-iteration stress results are generated in bulk; preserve only the
# campaign summaries and selected diagnostic evidence.
/37075/failure-evidence/**/iteration.json

# Matter controller runtime state contains generated test fabric private keys.
/37075/**/admin-*.json
/37075/**/admin-storage*.json
/37075/**/admin_storage*.json

# RCP firmware build trees and generated flash package.
/37075/nrf52840dongle-rcp-build/
/37075/nrf52840dongle-rcp-build-container/
/37075/nrf52840dongle-rcp.zip

# Locally installed/modified tools and Python environment.
