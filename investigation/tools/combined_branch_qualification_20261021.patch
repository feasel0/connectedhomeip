+TEST_F_FROM_FIXTURE(TestOperationalSessionSetupBusy, BusyDelayRegistersDeadlineAndIsConsumed)
+{
+    System::Clock::Internal::RAIIMockClock mockClock;
+    OperationalSessionSetup sessionSetup = CreateSessionSetup();
+    sessionSetup.mRemainingAttempts      = 0;
+    sessionSetup.mResolveAttemptsAllowed = 0;
+    sessionSetup.mAttemptsDone           = 1;
+    sessionSetup.OnResponderBusy(System::Clock::Milliseconds16(65001));
+    System::Clock::Seconds16 reportedDelay;
+    ASSERT_EQ(sessionSetup.ScheduleSessionSetupReattempt(reportedDelay), CHIP_NO_ERROR);
+    EXPECT_TRUE(GetSystemLayer().IsTimerActive(OperationalSessionSetup::TrySetupAgain, &sessionSetup));
+    EXPECT_EQ(GetSystemLayer().GetRemainingTime(OperationalSessionSetup::TrySetupAgain, &sessionSetup).count(), 65001u);
+    EXPECT_EQ(reportedDelay.count(), 65u);
+    EXPECT_EQ(sessionSetup.mRequestedBusyDelay, System::Clock::kZero);
+    sessionSetup.CancelSessionSetupReattempt();
+}
+
+TEST_F_FROM_FIXTURE(TestOperationalSessionSetupBusy, BusyDelayDoesNotShortenBackoff)
+{
+    System::Clock::Internal::RAIIMockClock mockClock;
+    OperationalSessionSetup sessionSetup = CreateSessionSetup();
+    sessionSetup.mRemainingAttempts      = 1;
+    sessionSetup.mAttemptsDone           = 3;
+    sessionSetup.OnResponderBusy(System::Clock::Milliseconds16(1));
+    System::Clock::Seconds16 reportedDelay;
+    ASSERT_EQ(sessionSetup.ScheduleSessionSetupReattempt(reportedDelay), CHIP_NO_ERROR);
+    const auto expected = System::Clock::Seconds16(CHIP_DEVICE_CONFIG_AUTOMATIC_CASE_RETRY_INITIAL_DELAY_SECONDS << 2);
+    EXPECT_EQ(GetSystemLayer().GetRemainingTime(OperationalSessionSetup::TrySetupAgain, &sessionSetup), expected);
+    sessionSetup.CancelSessionSetupReattempt();
+}
+
+TEST_F_FROM_FIXTURE(TestOperationalSessionSetupBusy, EvenAttemptAddsSigma2Timeout)
+{
+    System::Clock::Internal::RAIIMockClock mockClock;
+    OperationalSessionSetup sessionSetup = CreateSessionSetup();
+    sessionSetup.mRemainingAttempts      = 1;
+    sessionSetup.mAttemptsDone           = 2;
+    sessionSetup.OnResponderBusy(System::Clock::Milliseconds16(65001));
+    System::Clock::Seconds16 reportedDelay;
+    ASSERT_EQ(sessionSetup.ScheduleSessionSetupReattempt(reportedDelay), CHIP_NO_ERROR);
+    const auto expected = System::Clock::Milliseconds32(65001) +
+        CASESession::ComputeSigma2ResponseTimeout(GetLocalMRPConfig().ValueOr(GetDefaultMRPConfig()));
+    EXPECT_EQ(GetSystemLayer().GetRemainingTime(OperationalSessionSetup::TrySetupAgain, &sessionSetup), expected);
+    sessionSetup.CancelSessionSetupReattempt();
+}
+
+TEST_F_FROM_FIXTURE(TestOperationalSessionSetupBusy, BusyTimerConsumesGrantedBudgetsOnlyOnce)
+{
+    System::Clock::Internal::RAIIMockClock mockClock;
+    OperationalSessionSetup sessionSetup(CreateInitParams(), &mClientPool, ScopedNodeId(kTestNodeId, kUndefinedFabricIndex),
+                                         &mReleaseDelegate);
+    sessionSetup.mRemainingAttempts      = 0;
+    sessionSetup.mResolveAttemptsAllowed = 0;
+    sessionSetup.mAttemptsDone           = 1;
+    sessionSetup.OnResponderBusy(System::Clock::Milliseconds16(5000));
+    System::Clock::Seconds16 reportedDelay;
+    ASSERT_EQ(sessionSetup.ScheduleSessionSetupReattempt(reportedDelay), CHIP_NO_ERROR);
+    sessionSetup.MoveToState(OperationalSessionSetup::State::WaitingForRetry);
+    const auto delay = GetSystemLayer().GetRemainingTime(OperationalSessionSetup::TrySetupAgain, &sessionSetup);
+    mockClock.AdvanceMonotonic(delay - System::Clock::Milliseconds32(1));
+    EXPECT_EQ(sessionSetup.mRemainingAttempts, 1u);
+    EXPECT_EQ(sessionSetup.mResolveAttemptsAllowed, 1u);
+    EXPECT_EQ(mReleaseDelegate.mReleaseCalls, 0u);
+    mockClock.AdvanceMonotonic(System::Clock::Milliseconds32(1));
+    auto & loop = static_cast<System::LayerSelectLoop &>(GetSystemLayer());
+    loop.PrepareEvents();
+    loop.WaitForEvents();
+    loop.HandleEvents();
+    EXPECT_EQ(mReleaseDelegate.mReleaseCalls, 1u);
+    EXPECT_EQ(sessionSetup.mRemainingAttempts, 0u);
+    EXPECT_EQ(sessionSetup.mResolveAttemptsAllowed, 0u);
+    EXPECT_EQ(sessionSetup.mAttemptsDone, 2u);
+    EXPECT_FALSE(GetSystemLayer().IsTimerActive(OperationalSessionSetup::TrySetupAgain, &sessionSetup));
+    sessionSetup.OnResponderBusy(System::Clock::Milliseconds16(5000));
+    EXPECT_EQ(sessionSetup.mRemainingAttempts, 0u);
+    EXPECT_EQ(sessionSetup.mResolveAttemptsAllowed, 0u);
+    EXPECT_TRUE(sessionSetup.mGrantedBusyRetryAfterAttemptExhaustion);
+}
+
+TEST_F_FROM_FIXTURE(TestOperationalSessionSetupBusy, ExhaustedBusyErrorReleasesClientAndSchedulesGrantedRetry)
+{
+    System::Clock::Internal::RAIIMockClock mockClock;
+    CASEClientPool<1> clients;
+    OperationalSessionSetup sessionSetup(CreateInitParams(), &clients, ScopedNodeId(kTestNodeId, kUndefinedFabricIndex),
+                                         &mReleaseDelegate);
+    sessionSetup.mCASEClient = clients.Allocate();
+    ASSERT_NE(sessionSetup.mCASEClient, nullptr);
+    sessionSetup.MoveToState(OperationalSessionSetup::State::Connecting);
+    sessionSetup.mRemainingAttempts      = 0;
+    sessionSetup.mResolveAttemptsAllowed = 0;
+    sessionSetup.mAttemptsDone           = 1;
+    sessionSetup.OnResponderBusy(System::Clock::Milliseconds16(5000));
+    sessionSetup.OnSessionEstablishmentError(CHIP_ERROR_BUSY, SessionEstablishmentStage{});
+    EXPECT_EQ(sessionSetup.mCASEClient, nullptr);
+    EXPECT_EQ(sessionSetup.mState, OperationalSessionSetup::State::WaitingForRetry);
+    EXPECT_EQ(sessionSetup.mRemainingAttempts, 1u);
+    EXPECT_EQ(sessionSetup.mResolveAttemptsAllowed, 1u);
+    EXPECT_EQ(mReleaseDelegate.mReleaseCalls, 0u);
+    EXPECT_TRUE(GetSystemLayer().IsTimerActive(OperationalSessionSetup::TrySetupAgain, &sessionSetup));
+    CASEClient * reclaimed = clients.Allocate();
+    EXPECT_NE(reclaimed, nullptr);
+    if (reclaimed != nullptr)
+    {
+        clients.Release(reclaimed);
+    }
+    sessionSetup.MoveToState(OperationalSessionSetup::State::NeedsAddress);
+    EXPECT_FALSE(GetSystemLayer().IsTimerActive(OperationalSessionSetup::TrySetupAgain, &sessionSetup));
+}
+
 #endif // CHIP_DEVICE_CONFIG_ENABLE_AUTOMATIC_CASE_RETRIES
 
